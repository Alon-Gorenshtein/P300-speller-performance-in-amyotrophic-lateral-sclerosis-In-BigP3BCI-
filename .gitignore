.venv/
__pycache__/
.pytest_cache/
*.py[cod]

data/
tmp/

# Analysis outputs are not tracked, with one deliberate exception. The manuscript's availability
# statement promises the frozen outputs alongside the code, and the supplement lists all 24 of them
# by filename, so `output/expanded/` is tracked: the promise is kept on a fresh checkout, and any
# silent drift in the outputs the paper is written from shows up as a diff. `output/*` rather than
# `output/` because git cannot re-include a path whose parent directory is itself excluded.
# The intermediate, final, smoke-test and reference outputs stay untracked.
output/*
!output/expanded/

# Rendered delivery artifacts are reproducible from tracked manuscript sources.
manuscript/*.pdf
manuscript/*.docx
manuscript/rendered_pages/
supplementary/*.pdf
supplementary/*.docx
supplementary/rendered_pages/
submission/final_submission/
submission/clean_bundle/
submission/Submission_Ready_ALS_P300_Calibration/
submission/*.zip
manuscript/import_zotero.sh
manuscript/references_source_AMA.txt
manuscript/references_source_IEEE.tex
manuscript/references_source_diffs.txt
manuscript/references_source_for_zotero.bib
manuscript/references_source_verified.json
manuscript/references_source_zotero_plan.json

# macOS AppleDouble sidecars created on the external exFAT volume.
._*
